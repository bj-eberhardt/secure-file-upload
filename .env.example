JAVA_OPTS=-Xms256m -Xmx768m

SECURE_UPLOAD_STORAGE_DIR=/data/uploads
SECURE_UPLOAD_PROTOCOL_VERSION=v1
SECURE_UPLOAD_CHUNK_SIZE=8388608
SECURE_UPLOAD_MIN_CHUNK_BYTES=1048576
SECURE_UPLOAD_MAX_CHUNK_BYTES=67108864
SECURE_UPLOAD_DEFAULT_EXPIRY_HOURS=72
SECURE_UPLOAD_MAX_EXPIRY_HOURS=168
SECURE_UPLOAD_TRUST_PROXY_HEADERS=false
SECURE_UPLOAD_RATE_LIMIT_ENABLED=true
SECURE_UPLOAD_MAX_ACTIVE_UPLOADS_PER_IP=5
SECURE_UPLOAD_INIT_REQUESTS_PER_MINUTE=30
SECURE_UPLOAD_DOWNLOAD_REQUESTS_PER_MINUTE=60
SECURE_UPLOAD_DOWNLOAD_CHUNK_REQUESTS_PER_MINUTE=600
SECURE_UPLOAD_UPLOAD_CHUNK_REQUESTS_PER_MINUTE=600
SECURE_UPLOAD_CLEANUP_ENABLED=true
SECURE_UPLOAD_CLEANUP_INTERVAL_MINUTES=15
